# Copy to terraform.tfvars and fill in real values.
# NEVER commit terraform.tfvars — it is in .gitignore.
# Prefer TF_VAR_* environment variables for secrets in CI/CD.

aws_region  = "us-east-1"
env         = "dev"
project     = "restaurant-platform"
phase       = "phase1"

db_username = "restaurantadmin"

github_repo_url     = "https://github.com/sr0626/restaurant-platform"
github_access_token = "github_pat_REPLACE_ME"

allowed_origins = [
  "http://localhost:3000",
  "https://main.REPLACE_WITH_AMPLIFY_ID.amplifyapp.com"
]

aurora_max_capacity = 4
