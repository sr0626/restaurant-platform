# Copy to .env.local (gitignored) and fill in real values. Never commit
# real values here — see frontend/CLAUDE.md "Environment Variables" and
# root CLAUDE.md "NEVER hardcode secrets... in any file".

# Backend API Gateway URL
NEXT_PUBLIC_API_URL=

# Cognito user pool used for owner/manager/admin/registered_user auth
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=

# OpenStreetMap tile URL (no key needed) — never Google Maps
NEXT_PUBLIC_MAPS_TILE_URL=
